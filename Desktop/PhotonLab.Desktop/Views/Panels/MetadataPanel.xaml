<UserControl x:Class="PhotonLab.Desktop.Views.Panels.MetadataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <GroupBox Header="Image Metadata"
              Margin="5">

        <ScrollViewer>

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="Width"/>
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding Width}"/>

                <TextBlock Grid.Row="1" Text="Height"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Height}"/>

                <TextBlock Grid.Row="2" Text="Bit Depth"/>
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding BitDepth}"/>

                <TextBlock Grid.Row="3" Text="Pixel Format"/>
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding PixelFormat}"/>

                <TextBlock Grid.Row="4" Text="File Size"/>
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding FileSize}"/>

                <TextBlock Grid.Row="5" Text="File Name"/>
                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Text="{Binding FileName}"/>

            </Grid>

        </ScrollViewer>

    </GroupBox>

</UserControl>
