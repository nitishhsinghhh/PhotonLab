<Window x:Class="PhotonLab.Desktop.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PhotonLab"
        Height="450"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">

            <TextBlock Text="PhotonLab"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="High Performance 16-Bit TIFF Imaging Workstation"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,20">

            <TextBlock Text="Version 1.0.0"/>

            <TextBlock Margin="0,10,0,0"
                       Text="Native C++ Processing Engine"/>

            <TextBlock Text="WPF MVVM Desktop Platform"/>

            <TextBlock Text="Apache License 2.0"/>

            <TextBlock Margin="0,20,0,0"
                       Text="Copyright © Nitish Singh"/>

        </StackPanel>

        <Button Grid.Row="2"
                Width="120"
                Height="35"
                Content="Close"
                HorizontalAlignment="Center"
                IsCancel="True"/>
    </Grid>

</Window>
