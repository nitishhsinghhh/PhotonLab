<UserControl x:Class="PhotonLab.Desktop.Controls.PixelInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <GroupBox Header="Pixel Inspector">

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding PixelPosition}" />

            <TextBlock Grid.Row="1"
                       Text="{Binding PixelValue}" />

            <TextBlock Grid.Row="2"
                       Text="{Binding PixelIntensity}" />

        </Grid>

    </GroupBox>

</UserControl>
